---
// An iPhone drawn in SVG over a raw screenshot: silver band, antenna breaks, side buttons,
// black bezel and Dynamic Island. Everything scales from one 416×850 box, so the frame
// stays in proportion at any width. The shots in public/shots are 660×1434, the same
// ratio as the screen opening.
interface Props {
  shot: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { shot, alt, loading = 'lazy', class: className = '' } = Astro.props;

const W = 416;
const H = 850;
const OX = 3; // room on each side for the buttons
const outer = { x: OX + 1.4, y: 0.8, w: 407.4, h: 848.4, r: 62 };
const body = { x: OX + 5.8, y: 5.2, w: 398.6, h: 839.6, r: 57 };
const hole = { x: OX + 17.1, y: 16.1, w: 376, h: 817.8, r: 50 };
const island = { x: hole.x + 129.6, y: hole.y + 10.3, w: 116.8, h: 34.6 };
// Antenna breaks: [x, y, w, h]
const ticks = [
  [OX + 81, 0.8, 4.5, 4.4],
  [OX + 325.5, 844.8, 4.5, 4.4],
  [OX + 1.4, 82, 4.4, 4.5],
  [OX + 1.4, 762, 4.4, 4.5],
  [OX + 404.4, 83, 4.4, 4.5],
  [OX + 404.4, 764, 4.4, 4.5],
];
// Side buttons: action, volume up, volume down on the left; power on the right.
const buttons = [
  [0.4, 150, 4, 32],
  [0.4, 212, 4, 60],
  [0.4, 288, 4, 60],
  [W - 4.4, 250, 4, 95],
];

const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
// A rounded rectangle as a path, so the band and bezel can be drawn with the screen cut out.
const rr = ({ x, y, w, h, r }: { x: number; y: number; w: number; h: number; r: number }) =>
  `M${x + r} ${y}h${w - 2 * r}a${r} ${r} 0 0 1 ${r} ${r}v${h - 2 * r}a${r} ${r} 0 0 1 -${r} ${r}h-${w - 2 * r}a${r} ${r} 0 0 1 -${r} -${r}v-${h - 2 * r}a${r} ${r} 0 0 1 ${r} -${r}z`;

// The screenshot sits one unit under the bezel on every side, so no gap shows at any scale.
const screen = {
  left: pct(hole.x - 1, W),
  top: pct(hole.y - 1, H),
  width: pct(hole.w + 2, W),
  height: pct(hole.h + 2, H),
  'border-radius': `${pct(hole.r + 1, hole.w + 2)} / ${pct(hole.r + 1, hole.h + 2)}`,
};
// One gradient per phone; the id only has to be unique on the page.
const band = `band-${shot}-${className.replace(/\W+/g, '') || 'p'}`;
---

<div class:list={['iphone', className]}>
  <div class="iphone-screen" style={screen}>
    <img src={`/shots/${shot}.webp`} width="660" height="1434" alt={alt} loading={loading} decoding="async" />
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id={band} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#D4D5D7"></stop>
        <stop offset=".5" stop-color="#C2C3C6"></stop>
        <stop offset="1" stop-color="#D8D9DB"></stop>
      </linearGradient>
    </defs>
    {buttons.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} rx="1.6" fill="#A9ABAF" />)}
    <path d={rr(outer) + rr(hole)} fill-rule="evenodd" fill={`url(#${band})`}></path>
    <rect
      x={outer.x + 0.8}
      y={outer.y + 0.8}
      width={outer.w - 1.6}
      height={outer.h - 1.6}
      rx={outer.r - 0.8}
      fill="none"
      stroke="#8E9094"
      stroke-width="1.4"></rect>
    {ticks.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} fill="#3A3B3E" />)}
    <path d={rr(body) + rr(hole)} fill-rule="evenodd" fill="#050505"></path>
    <rect x={island.x} y={island.y} width={island.w} height={island.h} rx={island.h / 2} fill="#000"></rect>
  </svg>
</div>
