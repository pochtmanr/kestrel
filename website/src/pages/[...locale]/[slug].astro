---
import Base from '../../layouts/Base.astro';
import { t, site, locales, legalSlugs, legalPage, localeOf } from '../../lib.mjs';

export function getStaticPaths() {
  return locales.flatMap((l) => legalSlugs.map((slug) => ({ params: { locale: l.path || undefined, slug } })));
}

const locale = localeOf(Astro.params.locale).code;
const { slug } = Astro.params;
const s = t(locale);
const page = legalPage(locale, slug);
// Wide tables scroll inside their own box on phones instead of stretching the page.
const html = page.html.replaceAll('<table>', '<div class="table-scroll"><table>').replaceAll('</table>', '</table></div>');
---

<Base locale={locale} slug={slug} title={`${page.title} | ${site.appName}`} description={page.description}>
  <article class="wrap doc">
    <header class="doc-head">
      <h1>{page.title}</h1>
      <p class="doc-meta">
        {s.doc.updated}
        {s.doc.prevails && <><br />{s.doc.prevails}</>}
      </p>
    </header>
    <div class="prose" set:html={html} />
  </article>
</Base>
